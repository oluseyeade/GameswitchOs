# Copy to .env and update values.
# Railway-provided MySQL URLs can be supplied via DATABASE_URL.
# Example: mysql://user:pass@host:port/database
DATABASE_URL=

SECRET_KEY=change-this-secret

# MySQL connector settings (ignored if DATABASE_URL is provided)
DATABASE_DRIVER=mysql+pymysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
SQLALCHEMY_DATABASE_URI="mysql+pymysql://root@localhost/gameswitchos_demo"
MYSQL_USER=root
MYSQL_PASSWORD=password

# Tuya Cloud OpenAPI (backend only)
TUYA_BASE_URL=https://openapi.tuya.com
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_DEVICE_ID=bf1b57625b3b1a67dbjksk
TUYA_TIMEOUT_SECONDS=10
TUYA_MAX_RETRIES=3

# Optional Tuya inbound event shared secret for /api/user/tuya/events
TUYA_EVENT_SECRET=
TUYA_PULSAR_ENABLED=false
TUYA_PULSAR_BROKER_URL=
TUYA_PULSAR_TOPIC=
TUYA_PULSAR_SUBSCRIPTION=gameswitchos

# Optional Redis cache for Tuya token storage
REDIS_URL=

# Paystack (keep server-side only)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_SECONDS=15
PAYSTACK_MAX_RETRIES=3
PAYMENT_RATE_LIMIT_INITIALIZE_PER_MIN=10
PAYMENT_RATE_LIMIT_STATUS_PER_MIN=60
PAYMENT_WEBHOOK_REPLAY_TTL_SECONDS=900
PAYMENT_TRUST_PROXY=false
PAYMENT_TRUSTED_PROXY_IPS=127.0.0.1,::1
PAYMENT_JWT_REQUIRE_EXP=true

# Optional JWT (for API clients)
JWT_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
